# Copy this to a .env OUTSIDE the project directory. The preferred location is
#   ../.secrets/weather-advice/.env
# (relative to the project root), so that `git add -f`, a zipped folder or a
# copied directory cannot pick it up. Run
#   python -m weather_advice doctor
# to see which file was actually loaded.

# --- SMTP, for sending the alert ----------------------------------------
# Gmail requires an APP PASSWORD, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# --- Where the alert goes -----------------------------------------------
# A REAL inbox. This is the channel of record, because it is the only one
# that reliably tells you when it breaks. Comma-separated for more than one.
WEATHER_ALERT_EMAIL_TO=you@gmail.com

# Optional: text yourself through a carrier email-to-SMS gateway.
#
#   READ THIS FIRST. These gateways are being switched off, and the ones
#   still alive FAIL SILENTLY -- no bounce, no error:
#
#     T-Mobile  @tmomail.net   dead since around December 2024
#     AT&T      @txt.att.net   dead since 17 June 2025
#     Verizon   @vtext.com     works today; hard sunset 31 March 2027
#
#   `doctor` will warn you if you configure a dead one. Always keep
#   WEATHER_ALERT_EMAIL_TO set as well, so a dead gateway is survivable.
# WEATHER_ALERT_SMS_TO=5551234567@vtext.com

# --- Optional overrides -------------------------------------------------
# DRY_RUN=1
# WEATHER_DB=C:\path\to\history.db
